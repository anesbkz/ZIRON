rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-by-Default Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE AUTHORIZATION HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Permanent governance strictly relies on authoritative Firestore users/{uid}.roles or custom claims.
    // Email matching alone never authorizes administrative access.
    function isSuperAdmin() {
      return (hasUserDoc() && getUserData().roles.hasAny(['SUPER_ADMIN'])) ||
             (isSignedIn() && request.auth.token.keys().hasAny(['roles']) && request.auth.token.roles.hasAny(['SUPER_ADMIN']));
    }

    function isAdmin() {
      return isSuperAdmin() || (hasUserDoc() && getUserData().roles.hasAny(['ADMIN']));
    }

    function isStaff() {
      return isSuperAdmin() || (hasUserDoc() && getUserData().roles.hasAny([
        'SUPER_ADMIN',
        'ADMIN',
        'CONTENT_MANAGER',
        'COMMUNITY_MANAGER',
        'SCHOOL_MANAGER',
        'PRODUCT_MANAGER',
        'ORDER_MANAGER',
        'SUPPORT',
        'ANALYST'
      ]));
    }

    function hasStaffRole(allowedRoles) {
      return isSuperAdmin() || (hasUserDoc() && getUserData().roles.hasAny(allowedRoles));
    }

    // Authoritative entitlement check against entitlements collection
    function hasActiveEntitlement(type) {
      return isStaff() || exists(/databases/$(database)/documents/entitlements/$(request.auth.uid + '_' + type));
    }

    function hasCommunityEntitlement() {
      return hasActiveEntitlement('COMMUNITY_ACCESS');
    }

    function hasSchoolEntitlement() {
      return hasActiveEntitlement('SCHOOL_ACCESS');
    }

    // =========================================================================
    // USERS COLLECTION
    // Customer profile self-management vs Protected Administrative RBAC Matrix
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();

      // Customer self-registration is strictly restricted to default CUSTOMER role
      // and locked status/entitlement defaults, with an exact allowed field whitelist.
      // Server-authoritative verification flags (emailVerified, phoneVerified) and administrative
      // attributes are strictly forbidden from client creation.
      allow create: if (
        isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'firstName',
          'lastName',
          'dateOfBirth',
          'phone',
          'phoneNumber',
          'country',
          'wilaya',
          'city',
          'address',
          'preferredLanguage',
          'locale',
          'profilePhotoUrl',
          'photoURL',
          'termsAcceptedAt',
          'privacyAcceptedAt',
          'termsVersion',
          'privacyVersion',
          'status',
          'roles',
          'createdAt',
          'updatedAt',
          'onboardingCompleted',
          'communityAccess',
          'schoolAccess',
          'xp',
          'level',
          'profileCompleteness'
        ]) &&
        !incoming().keys().hasAny(['emailVerified', 'phoneVerified']) &&
        incoming().roles == ['CUSTOMER'] &&
        incoming().status == 'active' &&
        incoming().communityAccess == false &&
        incoming().schoolAccess == false &&
        incoming().xp == 0 &&
        incoming().level == 1 &&
        incoming().createdAt is string &&
        incoming().updatedAt is string
      );

      // Profile updates: Only customer modifying own safe demographic fields.
      // Roles, status, entitlements, and verification flags CANNOT be modified directly by clients.
      // All administrative role updates MUST go through the authoritative assignUserRoles Cloud Function.
      allow update: if (
        isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'displayName',
          'dateOfBirth',
          'phone',
          'phoneNumber',
          'country',
          'wilaya',
          'city',
          'address',
          'preferredLanguage',
          'profilePhotoUrl',
          'photoURL',
          'locale',
          'profileCompleteness',
          'onboardingCompleted',
          'updatedAt'
        ]) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'roles',
          'status',
          'communityAccess',
          'schoolAccess',
          'xp',
          'level',
          'emailVerified',
          'phoneVerified',
          'createdAt',
          'uid',
          'email'
        ])
      );

      // Only Super Admin can hard delete a user document
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // ENTITLEMENTS COLLECTION (Authoritative product-derived grants)
    // Client creation/mutation forbidden. Cloud Functions use Admin SDK.
    // =========================================================================
    match /entitlements/{entitlementId} {
      allow get: if isOwner(existing().userId) || isStaff();
      allow list: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // =========================================================================
    // ACTIVATIONS COLLECTION (Container serial code activation audit)
    // Immutable. Created only by authoritative Cloud Function.
    // =========================================================================
    match /activations/{activationId} {
      allow get: if isOwner(existing().userId) || isStaff();
      allow list: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // =========================================================================
    // PRODUCT CODES COLLECTION (Cryptographic Container Serials)
    // Activation is strictly server-authoritative (activateContainerCode Cloud Function).
    // Client creation enforces unactivated initial state.
    // Client updates are strictly limited to administrative metadata (activation fields immutable).
    // =========================================================================
    match /productCodes/{codeId} {
      allow get, list: if isStaff();
      
      // Staff can create serialized codes, but codes MUST initialize unactivated
      allow create: if (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'PRODUCT_MANAGER']) &&
        incoming().isActivated == false &&
        (!('activatedByUserId' in incoming()) || incoming().activatedByUserId == null) &&
        (!('activatedAt' in incoming()) || incoming().activatedAt == null)
      );

      // Direct client updates restricted to safe administrative metadata only.
      // isActivated, activatedByUserId, activatedAt CANNOT be modified from the client.
      allow update: if (
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'PRODUCT_MANAGER']) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['isActivated', 'activatedByUserId', 'activatedAt', 'code', 'id']) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['batchId', 'productSku', 'metadata', 'expiresAt', 'updatedAt', 'notes', 'status', 'description'])
      );

      // Staff may delete unactivated codes; activated codes cannot be deleted to preserve provenance
      allow delete: if hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'PRODUCT_MANAGER']) && existing().isActivated == false;
    }

    // =========================================================================
    // AUDIT LOGS (Immutable Append-Only Security Trail)
    // Clients CANNOT write or spoof audit logs.
    // Authoritative audit logs are created ONLY by trusted server-side Cloud Functions.
    // =========================================================================
    match /auditLogs/{logId} {
      allow get, list: if hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'ANALYST']);
      allow create, update, delete: if false;
    }

    // =========================================================================
    // SCHOOL CATEGORIES & COURSES (Curricula CMS)
    // Direct client writes are forbidden. Curricula management is strictly server-authoritative
    // via createSchoolCategory, updateSchoolCategory, deleteSchoolCategory,
    // createSchoolCourse, updateSchoolCourse, deleteSchoolCourse Cloud Functions.
    // =========================================================================
    match /schoolCategories/{categoryId} {
      allow get, list: if (existing().isPublished == true) || isStaff();
      allow create, update, delete: if false;
    }

    match /schoolCourses/{courseId} {
      allow get, list: if (existing().isPublished == true) || isStaff();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // CERTIFICATES (Private Verified Credentials)
    // Full records are restricted to the student and staff.
    // Public verification uses the separate non-enumerable /publicCertificates collection.
    // =========================================================================
    match /certificates/{certificateId} {
      allow get: if isOwner(existing().userId) || isStaff();
      allow list: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // =========================================================================
    // PUBLIC CERTIFICATES (Non-Enumerable Verification Endpoint)
    // Keyed by certificateNumber (e.g., VIR-CERT-...).
    // Allows direct get of known certificate, strictly forbids collection listing/enumeration.
    // =========================================================================
    match /publicCertificates/{certificateNumber} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COMMUNITY POST LIKES (Deterministic Single-Like Model)
    // Keyed by {postId}_{userId}. Prevents duplicate likes.
    // Manipulated atomically via Cloud Function togglePostLike.
    // =========================================================================
    match /communityPostLikes/{likeId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COMMUNITY ANNOUNCEMENTS
    // Creation, update, and deletion are strictly server-authoritative
    // via Cloud Functions with authoritative audit logs.
    // =========================================================================
    match /communityAnnouncements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // COMMUNITY POSTS & MODERATION
    // Author updates are limited to content only when unlocked.
    // Moderation (status, lock, pin) is strictly server-authoritative via moderateCommunityPost.
    // Authors may delete own posts ONLY if unlocked and published (preserves moderation history).
    // =========================================================================
    match /communityPosts/{postId} {
      allow get, list: if isSignedIn() && (existing().status == 'published' || isStaff());

      allow create: if (
        isSignedIn() &&
        incoming().authorId == request.auth.uid &&
        hasCommunityEntitlement() &&
        incoming().status == 'published' &&
        incoming().likesCount == 0 &&
        incoming().commentsCount == 0 &&
        incoming().isPinned == false &&
        incoming().isLocked == false &&
        incoming().title is string &&
        incoming().title.size() <= 200 &&
        incoming().body is string &&
        incoming().body.size() <= 5000
      );

      // Author editing own text (cannot edit if post was locked by moderator).
      // Direct client moderation updates removed: moderation must use moderateCommunityPost Cloud Function.
      allow update: if (
        isOwner(existing().authorId) &&
        existing().isLocked == false &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'tags', 'updatedAt']) &&
        incoming().title is string &&
        incoming().title.size() <= 200 &&
        incoming().body is string &&
        incoming().body.size() <= 5000
      );

      // Deletion policy: Author can delete own post ONLY if unlocked and published.
      // Staff (SUPER_ADMIN, ADMIN, COMMUNITY_MANAGER) can delete any post.
      allow delete: if (
        (isOwner(existing().authorId) && existing().isLocked == false && existing().status == 'published') ||
        hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'COMMUNITY_MANAGER'])
      );
    }

    // =========================================================================
    // COMMUNITY REPORTS
    // Created by authenticated users.
    // Resolution is strictly server-authoritative via resolveCommunityReport Cloud Function.
    // =========================================================================
    match /communityReports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterUserId == request.auth.uid && incoming().status == 'PENDING';
      allow get, list: if hasStaffRole(['SUPER_ADMIN', 'ADMIN', 'COMMUNITY_MANAGER']);
      allow update, delete: if false; // Must be resolved via resolveCommunityReport Cloud Function
    }

    // =========================================================================
    // CMS CONTENT
    // All updates route through updateCmsSection Cloud Function.
    // Direct client mutation is forbidden.
    // =========================================================================
    match /cmsContent/{sectionKey} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // SYSTEM GOVERNANCE METADATA
    // Internal metadata docs (e.g. _system/governance). Client access is denied.
    // =========================================================================
    match /_system/{docId} {
      allow read, write: if false;
    }
  }
}
